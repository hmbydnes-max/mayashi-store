<footer class="footer"><div class="container">© <span id="year"></span> MAYASHI STORE. All rights reserved. <span style="float:right">Gaming Service • Made with care</span></div></footer><div class="toast" id="toast">Paket dipilih!</div>
<script>
const ADMIN_WA='628972330684'; // WhatsApp admin MAYASHI, format internasional tanpa +
function parseNum(v){v=String(v).trim().toUpperCase().replace(/,/g,'');let m=v.match(/^([0-9]*\.?[0-9]+)\s*([KMBT])?$/);if(!m)return NaN;return Number(m[1])*({'':1,K:1e3,M:1e6,B:1e9,T:1e12}[m[2]||'']);}
function fmt(n){if(!Number.isFinite(n))return '—';if(Math.abs(n)>=1e12)return (n/1e12).toFixed(2).replace(/\.00$/,'')+'T';if(Math.abs(n)>=1e9)return (n/1e9).toFixed(2).replace(/\.00$/,'')+'B';if(Math.abs(n)>=1e6)return (n/1e6).toFixed(2).replace(/\.00$/,'')+'M';if(Math.abs(n)>=1e3)return (n/1e3).toFixed(2).replace(/\.00$/,'')+'K';return Math.round(n*100)/100+'';}
function calc(){let base=parseNum(document.getElementById('speed').value),mult=+document.getElementById('mult').value,tread=+document.getElementById('tread').value,trail=+document.getElementById('trail').value,hours=Math.max(0,Math.min(1000,+document.getElementById('afk').value||0));if(!Number.isFinite(base)||base<0){document.getElementById('rSummary').textContent='Masukkan speed yang valid, contoh 10K atau 2.5M.';return;}let step=mult*tread*trail,perSec=step,perMin=perSec*60,perHour=perMin*60,total=base+perHour*hours;document.getElementById('rCurrent').textContent=fmt(base);document.getElementById('rStep').textContent=fmt(step);document.getElementById('rSec').textContent=fmt(perSec);document.getElementById('rMin').textContent=fmt(perMin);document.getElementById('rHour').textContent=fmt(perHour);document.getElementById('rTime').textContent=hours+' jam';document.getElementById('rTotal').textContent=fmt(total);document.getElementById('rSummary').textContent='Estimasi penambahan '+fmt(perHour*hours)+' selama '+hours+' jam. Diasumsikan 1 step/detik; mekanik aktual dapat berbeda.';}
document.getElementById('calcBtn').addEventListener('click',calc);['speed','mult','tread','trail','afk'].forEach(id=>document.getElementById(id).addEventListener('change',calc));function toast(msg){let t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2200)}function selectPackage(name){document.getElementById('package').value=name;document.getElementById('order').scrollIntoView({behavior:'smooth'});toast(name+' dipilih');}function sendOrder(){let pack=document.getElementById('package').value,user=document.getElementById('username').value.trim(),wa=document.getElementById('wa').value.trim(),notes=document.getElementById('notes').value.trim();if(!user){toast('Isi username game terlebih dahulu');document.getElementById('username').focus();return;}let msg='Halo MAYASHI STORE, saya ingin order:%0A%0APaket: '+encodeURIComponent(pack)+'%0AUsername: '+encodeURIComponent(user)+'%0ANomor saya: '+encodeURIComponent(wa||'-')+'%0ACatatan: '+encodeURIComponent(notes||'-');if(!ADMIN_WA){toast('Nomor WhatsApp admin belum tersedia.');return;}window.open('https://wa.me/'+ADMIN_WA+'?text='+msg,'_blank','noopener');}document.getElementById('year').textContent=new Date().getFullYear();calc();
</script></body></html>
