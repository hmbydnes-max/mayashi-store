9px;outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--purple);box-shadow:0 0 0 3px #8b5cf622}.results{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.result{background:#0e0d1e;border:1px solid var(--line);border-radius:11px;padding:13px}.result small{display:block;color:var(--muted);font-size:11px}.result strong{font-size:19px;overflow-wrap:anywhere}.result.main{grid-column:1/-1;background:linear-gradient(110deg,#241943,#1a1831);border-color:#57418c}.hint{font-size:11px;color:var(--muted)}.prices{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.price{font-size:24px;font-weight:950;margin:9px 0}.price small{font-size:11px;color:var(--muted);font-weight:600}.featured{border-color:#7255bb;position:relative}.featured:before{content:'POPULER';position:absolute;right:12px;top:12px;color:#e9d5ff;background:#3a2865;border-radius:5px;padding:3px 6px;font-size:9px;font-weight:900}.order-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.faq details{background:var(--panel);border:1px solid var(--line);border-radius:11px;padding:13px 15px;margin:9px 0}.faq summary{font-weight:800;cursor:pointer}.faq details p{color:var(--muted);font-size:13px;margin-bottom:0}.contact{display:flex;align-items:center;justify-content:space-between;gap:15px;flex-wrap:wrap;background:linear-gradient(110deg,#241943,#18152d);border:1px solid #46376d;border-radius:15px;padding:22px}.footer{border-top:1px solid var(--line);padding:23px 0;color:var(--muted);font-size:12px}.toast{position:fixed;left:50%;bottom:18px;transform:translate(-50%,100px);opacity:0;transition:.25s;background:#e9d5ff;color:#211438;padding:11px 16px;border-radius:9px;font-weight:800;z-index:20}.toast.show{transform:translate(-50%,0);opacity:1}
